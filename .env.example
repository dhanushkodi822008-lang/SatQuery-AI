# SatQuery AI — copy to .env (never commit real secrets)
DEBUG=false
DEMO_MODE=false

# Optional: OpenWeatherMap (Open-Meteo is default and needs NO key)
OPENWEATHER_API_KEY=

# Optional: Connect to Supabase or other Postgres DB (defaults to local SQLite)
DATABASE_URL=

# ---- Email alerts (real SMTP) ----
# Leave blank to disable. Application reports "Email not configured" when missing.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
# SMTP_USERNAME is accepted as an alias for SMTP_USER.
SMTP_USERNAME=
SMTP_PASSWORD=your_app_password
SMTP_FROM=your_email@gmail.com

# ---- SMS alerts (real Twilio) ----
# Leave blank to disable. Application reports "SMS not configured" when missing.
# SMS_API_KEY = Twilio Account SID
# TWILIO_AUTH_TOKEN = Twilio Auth Token
SMS_PROVIDER=twilio
SMS_API_KEY=
TWILIO_AUTH_TOKEN=
SMS_FROM_NUMBER=

# Optional: Sentinel Hub for advanced WMS/processing
SENTINEL_HUB_CLIENT_ID=
SENTINEL_HUB_CLIENT_SECRET=

# Optional: NASA Earthdata
NASA_EARTHDATA_TOKEN=

# Optional: Planetary Computer subscription (search works without key)
PLANETARY_COMPUTER_SUBSCRIPTION_KEY=

# Optional: Vision-Language Model (OpenAI-compatible)
# When set, free-form image questions use the hosted VLM.
# Without a key, SatQuery falls back to evidence-only answers (never fabricates numbers).
VLM_API_KEY=
VLM_BASE_URL=https://api.openai.com/v1
VLM_MODEL=gpt-4o-mini

# Groq API (preferred for SatQuery AI chatbot)
# Get your key from https://console.groq.com/keys
# This enables high-performance AI responses for satellite analysis explanations
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Future: institutional river gauge API
# WATER_GAUGE_API_URL=
# WATER_GAUGE_API_KEY=
