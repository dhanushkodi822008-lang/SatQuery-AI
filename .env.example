# SatQuery AI — copy to .env (never commit real secrets)
DEBUG=false
DEMO_MODE=false

# Optional: OpenWeatherMap (Open-Meteo is default and needs NO key)
OPENWEATHER_API_KEY=

# Optional: Sentinel Hub for advanced WMS/processing
SENTINEL_HUB_CLIENT_ID=
SENTINEL_HUB_CLIENT_SECRET=

# Optional: NASA Earthdata
NASA_EARTHDATA_TOKEN=

# Optional: Planetary Computer subscription (search works without key)
PLANETARY_COMPUTER_SUBSCRIPTION_KEY=

# Optional: Vision-Language Model (OpenAI-compatible)
# When set, free-form image questions use the hosted VLM.
# Without a key, SatQuery falls back to evidence-only answers (never fabricates numbers).
VLM_API_KEY=
VLM_BASE_URL=https://api.openai.com/v1
VLM_MODEL=gpt-4o-mini

# Future: institutional river gauge API
# WATER_GAUGE_API_URL=
# WATER_GAUGE_API_KEY=
